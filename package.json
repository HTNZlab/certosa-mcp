  "exports": {
    ".": "./src/notebook-tools.mjs",
    "./secrets": "./src/secret-capabilities.mjs",
    "./archives": "./src/archive-engine.mjs",
    "./archive-format": "./src/archive-format.mjs",
    "./incremental": "./src/large-archive-store.mjs",
    "./archive-router": "./src/archive-router.mjs"
  },
  "files": [
    "src/",
    "tools.json",
    "secret-tools.json",
    "LICENSE",
    "README.md",
    "README.it.md",
    "DISTRIBUTION.md",
    "CHANGELOG.md",
    "LIVE-LAB.md",
    "skills/",
    "INSTALL.md",
    "tools/build-desktop.py",
    "assets/certosa.png",
    "INSTALL.it.md"
