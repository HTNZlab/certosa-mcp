{
  "name": "certosa-mcp",
  "version": "0.0.2-alpha.2",
  "description": "Local stdio MCP connector for the isolated Certosa test library, with encrypted writes and a non-disclosing fictional credential demo.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/notebook-tools.mjs",
    "./secrets": "./src/secret-capabilities.mjs"
  },
  "files": [
    "src/",
    "tools.json",
    "secret-tools.json",
    "LICENSE",
    "README.md",
    "README.it.md",
    "DISTRIBUTION.md",
    "CHANGELOG.md",
    "LIVE-LAB.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HTNZlab/certosa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/HTNZlab/certosa-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0"
  },
  "bin": {
    "certosa-mcp": "src/mcp-server.mjs",
    "certosa-mcp-lab": "src/lab-setup.mjs"
  }
}
