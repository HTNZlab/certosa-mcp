  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HTNZlab/certosa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/HTNZlab/certosa-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
