{
  "name": "certosa-mcp",
  "version": "0.0.3-alpha.2",
  "description": "Local MCP archive engine for .certosa files: native local unlock, scoped reading/search/counting and encrypted writes without the Certosa app.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/notebook-tools.mjs",
    "./secrets": "./src/secret-capabilities.mjs",
    "./archives": "./src/archive-engine.mjs",
    "./archive-format": "./src/archive-format.mjs"
  },
  "files": [
    "src/",
    "tools.json",
    "secret-tools.json",
    "LICENSE",
    "README.md",
    "README.it.md",
    "DISTRIBUTION.md",
    "CHANGELOG.md",
    "LIVE-LAB.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HTNZlab/certosa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/HTNZlab/certosa-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "parse5": "8.1.0"
  },
  "bin": {
    "certosa-mcp": "src/archive-mcp-server.mjs",
    "certosa-mcp-lab": "src/lab-setup.mjs",
    "certosa-archive-setup": "src/archive-setup.mjs",
    "certosa-browser-lab": "src/mcp-server.mjs"
  }
}
